    "@prisma/client": "^6.14.0",
    "cors": "^2.8.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "prisma": "^6.14.0",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.6",
    "@types/express": "^4.17.17",
    "@types/node": "^20.5.1"
  }
}
